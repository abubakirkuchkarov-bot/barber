// Схема. Колонка time_range и ограничение bookings_no_overlap заданы в SQL-миграции.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 0 = воскресенье … 6 = суббота, как Date.getDay().

enum BookingStatus {
  confirmed
  completed
  cancelled
  no_show

  @@map("booking_status")
}

enum BookingSource {
  web
  telegram
  admin

  @@map("booking_source")
}

enum TimeOffType {
  day_off
  vacation
  closed

  @@map("time_off_type")
}

model Barber {
  id              String  @id
  name            String
  photoUrl        String? @map("photo_url")
  bio             String?
  experienceYears Int     @map("experience_years")
  telegramChatId  String? @map("telegram_chat_id")
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  portfolio    PortfolioItem[]
  services     BarberService[]
  workingHours WorkingHour[]
  breaks       Break[]
  timeOff      TimeOff[]
  bookings     Booking[]
  reviews      Review[]
  linkCodes    BarberLinkCode[]

  @@map("barbers")
}

model PortfolioItem {
  id        String @id @default(uuid()) @db.Uuid
  barberId  String @map("barber_id")
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, sortOrder])
  @@map("portfolio_items")
}

model Service {
  id          String  @id
  name        String
  description String
  durationMin Int     @map("duration_min")
  price       Int
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  barbers         BarberService[]
  bookingServices BookingService[]

  @@map("services")
}

model BarberService {
  barberId    String  @map("barber_id")
  serviceId   String  @map("service_id")
  durationMin Int?    @map("duration_min")
  price       Int?    @map("price")
  isEnabled   Boolean @default(true) @map("is_enabled")

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

model WorkingHour {
  id        String   @id @default(uuid()) @db.Uuid
  barberId  String   @map("barber_id")
  weekday   Int
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
  @@map("working_hours")
}

model Break {
  id        String   @id @default(uuid()) @db.Uuid
  barberId  String   @map("barber_id")
  weekday   Int
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
  @@map("breaks")
}

model TimeOff {
  id       String      @id @default(uuid()) @db.Uuid
  barberId String?     @map("barber_id")
  startsAt DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime    @map("ends_at") @db.Timestamptz(6)
  type     TimeOffType
  note     String?

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt, endsAt])
  @@map("time_off")
}

model Client {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  phone          String
  telegramId     String?  @unique @map("telegram_id")
  telegramChatId String?  @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bookings Booking[]
  reviews  Review[]

  @@index([phone])
  @@map("clients")
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  clientId         String        @map("client_id") @db.Uuid
  barberId         String        @map("barber_id")
  startsAt         DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime      @map("ends_at") @db.Timestamptz(6)
  /// Generated: tstzrange(starts_at, ends_at, '[)'). Не писать из Prisma.
  timeRange        Unsupported("tstzrange")? @map("time_range")
  totalPrice       Int           @map("total_price")
  totalDurationMin Int           @map("total_duration_min")
  status           BookingStatus @default(confirmed)
  source           BookingSource
  manageToken      String        @unique @map("manage_token")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  reminderDaySentAt DateTime? @map("reminder_day_sent_at") @db.Timestamptz(6)
  reminder30mSentAt DateTime? @map("reminder_30m_sent_at") @db.Timestamptz(6)
  reviewRequestedAt DateTime? @map("review_requested_at") @db.Timestamptz(6)
  autoCompletedAt   DateTime? @map("auto_completed_at") @db.Timestamptz(6)

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  barber   Barber           @relation(fields: [barberId], references: [id], onDelete: Restrict)
  services BookingService[]
  review   Review?

  @@index([barberId, startsAt])
  @@map("bookings")
}

model BookingService {
  bookingId   String @map("booking_id") @db.Uuid
  serviceId   String @map("service_id")
  name        String
  durationMin Int    @map("duration_min")
  price       Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([bookingId, serviceId])
  @@map("booking_services")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  barberId  String   @map("barber_id")
  clientId  String   @map("client_id") @db.Uuid
  rating    Int
  comment   String?
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Restrict)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@map("reviews")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model BarberLinkCode {
  code      String    @id
  barberId  String    @map("barber_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("barber_link_codes")
}

model AdminUser {
  id             String  @id @default(uuid()) @db.Uuid
  login          String  @unique
  passwordHash   String  @map("password_hash")
  telegramChatId String? @map("telegram_chat_id")

  @@map("admin_users")
}
