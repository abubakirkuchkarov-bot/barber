# Supabase → Project Settings → Database → Connection string
# Transaction pooler, порт 6543. Эту строку использует приложение.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler, порт 5432. Её Prisma использует для миграций.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Project Settings → API. service_role только на сервере, не во frontend.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# apps/api
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Адреса API на проде. Значения задаются в окружении проектов, сюда не пишутся.
API_PROXY_URL=
NEXT_PUBLIC_API_URL=
VITE_API_URL=

# Бот создаётся в @BotFather: /newbot, имя «Кромка», username, затем скопировать токен сюда.
# Локальный выдуманный токен годится для подписи Mini App, но живые сообщения не отправит.
# TELEGRAM_DEV=1 включает GET /api/v1/telegram/dev-session и POST /api/v1/telegram/barber-links только вне production.
# TELEGRAM_POLLING=1 запускает long polling. Не включать вместе с webhook и не включать на выдуманном токене.
# TELEGRAM_MINIAPP_URL — только https, иначе кнопка «Записаться» ведёт на сайт.
# WEB_ORIGIN — адрес сайта для ссылки «Перенести» (нужен https, чтобы Telegram принял кнопку).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_POLLING=0
TELEGRAM_MINIAPP_URL=""
WEB_ORIGIN="http://localhost:3000"
TELEGRAM_DEV=0

# Вход на /admin/login. Пароль от 8 символов, в базе хранится только хеш Argon2.
# SESSION_SECRET подписывает httpOnly-cookie сессии.
ADMIN_LOGIN=owner
ADMIN_PASSWORD=""
SESSION_SECRET=""

# Секрет вызова напоминаний. Его же кладут в Supabase Vault под именем cron_secret
# и в секреты Edge Function. notifications_url в Vault:
# https://<project-ref>.supabase.co/functions/v1/notifications
# У функции ещё нужны DATABASE_URL (сессия, порт 5432) и TELEGRAM_BOT_TOKEN.
# Cron каждые 5 минут вызывает public.run_notification_tick(). Пока секретов нет, тик пустой.
CRON_SECRET=""
